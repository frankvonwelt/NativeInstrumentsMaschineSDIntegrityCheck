<Window x:Class="MxprjReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maschine SD Integrity Check" Height="600" Width="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="DriveComboBox" Width="200" Margin="0,0,10,0"/>
            <Button x:Name="RefreshDrivesButton" Content="Refresh Drives" Padding="8,2" Click="RefreshDrivesButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="ScanButton" Content="Scan" Padding="8,2" Click="ScanButton_Click"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ProjectsDataGrid" Grid.Column="0" Margin="0,0,10,0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="ProjectsDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="150"/>
                    <DataGridTextColumn Header="Broken?" Binding="{Binding IsPotentiallyBroken}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <ListBox x:Name="DetailsListBox" Grid.Column="1"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ExportButton" Content="Export Report..." Padding="8,2" Click="ExportButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
